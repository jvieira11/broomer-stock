API_PORT=3333
WEB_URL=http://localhost:3000

DATABASE_URL="postgresql://stock_user:stock_password@localhost:5434/stock_database?schema=public"

# Assinatura dos tokens de login. Gere um valor longo e aleatório, por exemplo:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-valor-aleatorio

# Tentativas de login por minuto, por IP
AUTH_RATE_LIMIT=10

# Produção: quantos proxies há na frente da API (o servidor do web = 1)
# TRUST_PROXY=1

# E-mails (esqueci minha senha) pelo Resend: resend.com > API Keys, chave
# "Sending access". Sem ela, no desenvolvimento o e-mail aparece no terminal.
# RESEND_API_KEY=
# Remetente. O padrão (onboarding@resend.dev) só entrega para o dono da conta
# Resend; use um endereço do seu domínio depois de verificá-lo no Resend.
# MAIL_FROM="Broomer Estoque <nao-responda@mail.seudominio.com.br>"

# Opcional: envia erros inesperados para o Sentry (sentry.io)
# SENTRY_DSN=

# Primeiro administrador, criado por `pnpm --filter api db:seed` (não há
# cadastro público). Senha com 12+ caracteres. Depois de criar, apague a senha
# daqui e troque-a em "Minha conta".
SEED_ORGANIZATION_NAME=Broomer
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@broomer.local
SEED_ADMIN_PASSWORD=troque-esta-senha
