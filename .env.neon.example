# Para docker-compose.neon.yml (banco no Neon). Copie para .env.neon, que
# NÃO vai para o git, preencha no servidor e proteja: chmod 600 .env.neon
# Nunca coloque estes valores no GitHub, no web ou no apps/api/.env.

# Domínio público, com o DNS (registro A) apontando para o servidor.
DOMAIN=estoque.suaempresa.com.br

# Banco no Neon: painel do projeto > Connect. Os dados ficam separados (em vez
# de uma URL pronta) porque a API usa duas conexões e o backup, as partes.
# Host da conexão direta (migrations e backup), ex.: ep-nome-123456.sa-east-1.aws.neon.tech
DB_HOST=
# Host com "-pooler" (uso normal da API), ex.: ep-nome-123456-pooler.sa-east-1.aws.neon.tech
DB_POOLER_HOST=
DB_USER=
# Senha gerada pelo Neon. Se trocar no painel, troque aqui e reinicie.
DB_PASSWORD=
DB_NAME=

# Assinatura dos logins. Gere com: openssl rand -base64 48
JWT_SECRET=

# E-mails (esqueci minha senha). Chave do resend.com com permissão só de envio,
# e o remetente num domínio verificado no Resend.
RESEND_API_KEY=
MAIL_FROM="Broomer Estoque <nao-responda@mail.suaempresa.com.br>"

# Opcional: DSN do projeto no sentry.io para receber os erros da API.
SENTRY_DSN=

# Tentativas de login por minuto, por IP.
AUTH_RATE_LIMIT=10

# Backups (pg_dump): intervalo (segundos) e por quantos dias guardar.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14
