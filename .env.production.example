# Copie para .env.production (NÃO vai para o git) e preencha.

# Domínio público, com o DNS (registro A) apontando para o servidor.
DOMAIN=estoque.suaempresa.com.br

# Banco. Use só letras e números na senha (ela vai dentro de uma URL).
# Gere com: openssl rand -hex 24
POSTGRES_USER=stock
POSTGRES_PASSWORD=
POSTGRES_DB=stock

# Assinatura dos logins. Gere com: openssl rand -base64 48
JWT_SECRET=

# E-mails (esqueci minha senha). Chave do resend.com com permissão só de envio,
# e o remetente num domínio verificado no Resend.
RESEND_API_KEY=
MAIL_FROM="Broomer Estoque <nao-responda@mail.suaempresa.com.br>"

# Opcional: DSN do projeto no sentry.io para receber os erros da API.
SENTRY_DSN=

# Tentativas de login/cadastro por minuto, por IP.
AUTH_RATE_LIMIT=10

# Backups: intervalo (segundos) e por quantos dias guardar.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14
